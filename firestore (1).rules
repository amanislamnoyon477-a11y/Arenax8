rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['YOUR_GMAIL@gmail.com'];
    }

    // শুধু অ্যাডমিন লিখতে পারবে, লগইন করা সবাই পড়তে পারবে
    match /tournaments/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /notices/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /approvals/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /depApprovals/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /payouts/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }

    // ইউজার শুধু নিজের ডকুমেন্ট লিখতে পারবে, অ্যাডমিন সব পড়তে পারবে
    match /regs/{uid}     { allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
                            allow write: if signedIn() && request.auth.uid == uid; }
    match /deposits/{uid} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
                            allow write: if signedIn() && request.auth.uid == uid; }
    match /data/users/{uid}/{doc} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
